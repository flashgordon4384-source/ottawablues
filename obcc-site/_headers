# Cloudflare reads this file and applies the headers below.
# Same reasoning as public/_headers: the HTML must never be cached,
# or a phone/browser keeps showing a stale build after a deploy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate
